function resetCropRect(full=true){if(!st.img)return;st.crop.rect={x:0,y:0,w:1,h:1};if(!full){st.crop.rect={x:.12,y:.08,w:.76,h:.84}}}
function readCropUI(){st.crop.zoom=Number(e.cropZoom.value);st.crop.panX=Number(e.cropX.value)/100;st.crop.panY=Number(e.cropY.value)/100}
function sourceRectFromCrop(){const img=st.img;if(!img)return{sx:0,sy:0,sw:1,sh:1};const rect=st.crop.rect||{x:0,y:0,w:1,h:1};let sx=rect.x*img.width,sy=rect.y*img.height,sw=rect.w*img.width,sh=rect.h*img.height;const zoom=Math.max(1,st.crop.zoom||1);const zsw=sw/zoom,zsh=sh/zoom;const mx=(sw-zsw)/2,my=(sh-zsh)/2;sx+=mx*(st.crop.panX+1);sy+=my*(st.crop.panY+1);sw=zsw;sh=zsh;sx=clamp(sx,0,img.width-sw);sy=clamp(sy,0,img.height-sh);return{sx,sy,sw,sh}}
function drawSourceGuide(){const s=st.size,cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100;e.sctx.save();e.sctx.strokeStyle='rgba(24,177,230,.95)';e.sctx.lineWidth=2.2;e.sctx.setLineDash([8,6]);e.sctx.beginPath();e.sctx.arc(cx,cy,r,0,Math.PI*2);e.sctx.stroke();e.sctx.setLineDash([]);e.sctx.fillStyle='rgba(255,255,255,.13)';e.sctx.beginPath();e.sctx.arc(cx,cy,3,0,Math.PI*2);e.sctx.fill();e.sctx.restore()}
