function applyProfile(autoProcess=true){const p=e.inputProfile.value,presets={portrait:{mode:'portrait',contrast:84,brightness:0,gamma:.92,cleanup:55,radius:43,pins:120,lines:1550,gap:7,impact:6,threadRadius:0,recent:14,minScore:10,penalty:85,pointStep:7,pointDensity:1.15,maxPoints:3200,plotWidth:200,plotHeight:200,plotMargin:6,hint:'Retrato: mezcla suave de sombras + rasgos, con leve priorización del centro. Mejor cuando la cara llena buena parte del círculo.'},photo:{mode:'balanced',contrast:78,brightness:0,gamma:.98,cleanup:48,radius:43,pins:120,lines:1900,gap:6,impact:6,threadRadius:0,recent:14,minScore:10,penalty:74,pointStep:8,pointDensity:1.0,maxPoints:2800,plotWidth:200,plotHeight:200,plotMargin:6,hint:'Foto general / animal / objeto: equilibrio entre masa tonal y contorno. Más uniforme que retrato y menos agresivo que bordes puros.'},drawing:{mode:'edges',contrast:118,brightness:0,gamma:.88,cleanup:72,radius:43,pins:120,lines:1300,gap:8,impact:6,threadRadius:0,recent:10,minScore:6,penalty:52,pointStep:9,pointDensity:.9,maxPoints:2200,plotWidth:200,plotHeight:200,plotMargin:6,hint:'Dibujo / pose / ilustración: prioriza bordes, pero ahora añade una sombra suave para no dejar figuras incompletas o demasiado vacías.'},logo:{mode:'shadows',contrast:110,brightness:0,gamma:.96,cleanup:110,radius:43,pins:120,lines:950,gap:9,impact:8,threadRadius:0,recent:10,minScore:5,penalty:40,pointStep:10,pointDensity:.82,maxPoints:1400,plotWidth:200,plotHeight:200,plotMargin:6,hint:'Logo / alto contraste: masas oscuras limpias y pocas líneas. Útil para símbolos y formas simples. Activa negativo si el diseño es claro sobre fondo oscuro.'}};const cfg=presets[p];e.detailMode.value=cfg.mode;e.contrast.value=cfg.contrast;e.brightness.value=cfg.brightness;e.gamma.value=cfg.gamma;e.cleanup.value=cfg.cleanup;e.circleRadius.value=cfg.radius;e.pinCount.value=cfg.pins;e.lineCount.value=cfg.lines;e.minGap.value=cfg.gap;e.impact.value=cfg.impact;e.threadRadius.value=cfg.threadRadius;e.recent.value=cfg.recent;e.minScore.value=cfg.minScore;e.edgePenalty.value=cfg.penalty;e.pointStep.value=cfg.pointStep;e.pointDensity.value=cfg.pointDensity;e.maxPoints.value=cfg.maxPoints;e.plotWidth.value=cfg.plotWidth;e.plotHeight.value=cfg.plotHeight;e.plotMargin.value=cfg.plotMargin;e.profileHint.textContent=cfg.hint;syncLabels();log('Preset investigado aplicado: '+p+'.');if(st.img){drawImage(st.img);if(autoProcess)processImage(false)}}
function handleCropChange(reprocess=true){syncLabels();if(st.img){drawImage(st.img);if(reprocess&&st.processed)processImage(false)}}
function cropCanvasPoint(ev){const r=e.cropCanvas.getBoundingClientRect();return{x:(ev.clientX-r.left)*(e.cropCanvas.width/r.width),y:(ev.clientY-r.top)*(e.cropCanvas.height/r.height)}}
function cropEditorBase(){const img=st.img,c=e.cropCanvas;const scale=Math.min(c.width/img.width,c.height/img.height);const w=img.width*scale,h=img.height*scale,x=(c.width-w)/2,y=(c.height-h)/2;return{scale,w,h,x,y}}
function ensureEditorRect(){if(!st.img)return;if(!st.crop.rect)resetCropRect(true);const r=st.crop.rect;const almostFull=r.w>.97&&r.h>.97&&r.x<.02&&r.y<.02;const base=almostFull?{x:.08,y:.08,w:.84,h:.84}:r;st.cropEditor={rect:{x:base.x,y:base.y,w:base.w,h:base.h},drag:null,zoom:Number(e.cropEditorZoom.value)||1}}
function drawCropEditor(){if(!st.img||!st.cropEditor)return;const ctx=e.cropCanvasCtx,c=e.cropCanvas,base=cropEditorBase();ctx.clearRect(0,0,c.width,c.height);ctx.fillStyle='#eefcff';ctx.fillRect(0,0,c.width,c.height);ctx.drawImage(st.img,base.x,base.y,base.w,base.h);const rr=st.cropEditor.rect;const px=base.x+rr.x*base.w,py=base.y+rr.y*base.h,pw=rr.w*base.w,ph=rr.h*base.h;ctx.save();ctx.fillStyle='rgba(7,32,41,.48)';ctx.beginPath();ctx.rect(0,0,c.width,c.height);ctx.rect(px,py,pw,ph);ctx.fill('evenodd');ctx.restore();ctx.save();ctx.strokeStyle='rgba(255,255,255,.98)';ctx.lineWidth=3;ctx.strokeRect(px,py,pw,ph);ctx.strokeStyle='rgba(25,189,233,.95)';ctx.lineWidth=2;ctx.strokeRect(px,py,pw,ph);const hs=12;[[px,py],[px+pw,py],[px+pw,py+ph],[px,py+ph]].forEach(([hx,hy])=>{ctx.fillStyle='#fff';ctx.strokeStyle='#14b4df';ctx.lineWidth=2.5;ctx.beginPath();ctx.roundRect(hx-hs,hy-hs,hs*2,hs*2,5);ctx.fill();ctx.stroke();ctx.beginPath();ctx.arc(hx,hy,2.5,0,Math.PI*2);ctx.fillStyle='#14b4df';ctx.fill()});ctx.restore();e.cropEditorZoomVal.textContent=(Number(e.cropEditorZoom.value)||1).toFixed(2)+'×';e.cropInfo.textContent=`Recorte: ${Math.round(rr.w*100)}% × ${Math.round(rr.h*100)}% del original. El rectángulo abre ligeramente metido para que sus tiradores sean fáciles de ver y mover.`}
function openCropEditor(){if(!st.img){alert('Primero carga una imagen.');return}ensureEditorRect();e.cropEditorZoom.value=String(st.crop.zoom||1);drawCropEditor();e.cropModal.classList.add('show');e.cropModal.setAttribute('aria-hidden','false')}
function closeCropEditor(){e.cropModal.classList.remove('show');e.cropModal.setAttribute('aria-hidden','true')}
function editorHitTest(pt){const b=cropEditorBase(),r=st.cropEditor.rect,px=b.x+r.x*b.w,py=b.y+r.y*b.h,pw=r.w*b.w,ph=r.h*b.h;const hs=14;const handles=[['nw',px,py],['ne',px+pw,py],['se',px+pw,py+ph],['sw',px,py+ph]];for(const [name,hx,hy] of handles){if(Math.abs(pt.x-hx)<=hs&&Math.abs(pt.y-hy)<=hs)return{type:'handle',name,base:b}}if(pt.x>=px&&pt.x<=px+pw&&pt.y>=py&&pt.y<=py+ph)return{type:'move',base:b};return null}
function clampRect(r){const min=.08;r.w=clamp(r.w,min,1);r.h=clamp(r.h,min,1);r.x=clamp(r.x,0,1-r.w);r.y=clamp(r.y,0,1-r.h);return r}
function startCropDrag(ev){if(!st.img||!st.cropEditor)return;const pt=cropCanvasPoint(ev),hit=editorHitTest(pt);if(!hit)return;st.cropEditor.drag={type:hit.type,name:hit.name,start:pt,rect:{...st.cropEditor.rect},base:hit.base};e.cropCanvas.setPointerCapture(ev.pointerId)}
function moveCropDrag(ev){if(!st.cropEditor?.drag)return;const d=st.cropEditor.drag,pt=cropCanvasPoint(ev),dx=(pt.x-d.start.x)/d.base.w,dy=(pt.y-d.start.y)/d.base.h,r={...d.rect};if(d.type==='move'){r.x+=dx;r.y+=dy}else{if(d.name.includes('w')){r.x+=dx;r.w-=dx}if(d.name.includes('e')){r.w+=dx}if(d.name.includes('n')){r.y+=dy;r.h-=dy}if(d.name.includes('s')){r.h+=dy}}st.cropEditor.rect=clampRect(r);drawCropEditor()}
function endCropDrag(ev){if(!st.cropEditor?.drag)return;st.cropEditor.drag=null;try{e.cropCanvas.releasePointerCapture(ev.pointerId)}catch(_){}drawCropEditor()}
function applyCropEditor(){if(!st.cropEditor)return;st.crop.rect={...st.cropEditor.rect};e.cropZoom.value=String(Number(e.cropEditorZoom.value)||1);st.crop.zoom=Number(e.cropEditorZoom.value)||1;e.cropX.value='0';e.cropY.value='0';st.crop.panX=0;st.crop.panY=0;syncLabels();closeCropEditor();drawImage(st.img);if(st.processed)processImage(false);log('Recorte manual aplicado.')}
function resetCropEditorRect(){if(!st.cropEditor)return;st.cropEditor.rect={x:.08,y:.08,w:.84,h:.84};drawCropEditor()}
function centerCropEditorRect(){if(!st.cropEditor)return;const r=st.cropEditor.rect;r.x=(1-r.w)/2;r.y=(1-r.h)/2;drawCropEditor()}
function bindCropDrag(){e.src.addEventListener('pointerdown',ev=>{if(!st.img||Number(e.cropZoom.value)<=1.01)return;st.cropDrag=true;st.dragPointer=ev.pointerId;st.dragStart={x:ev.clientX,y:ev.clientY,panX:Number(e.cropX.value),panY:Number(e.cropY.value)};e.src.setPointerCapture(ev.pointerId)});e.src.addEventListener('pointermove',ev=>{if(!st.cropDrag||ev.pointerId!==st.dragPointer)return;const z=Number(e.cropZoom.value),dx=ev.clientX-st.dragStart.x,dy=ev.clientY-st.dragStart.y,sense=220/Math.max(.35,z-1+.35);e.cropX.value=clamp(st.dragStart.panX-dx/e.src.clientWidth*sense,-100,100);e.cropY.value=clamp(st.dragStart.panY-dy/e.src.clientHeight*sense,-100,100);handleCropChange(false)});const finish=ev=>{if(!st.cropDrag)return;st.cropDrag=false;try{e.src.releasePointerCapture(ev.pointerId)}catch(_){}if(st.processed)processImage(false)};e.src.addEventListener('pointerup',finish);e.src.addEventListener('pointercancel',finish)}
function fileImg(file){return new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>res(im);im.onerror=rej;im.src=r.result};r.onerror=rej;r.readAsDataURL(file)})}async function onFile(ev){const f=ev.target.files&&ev.target.files[0];if(!f)return;try{st.img=await fileImg(f);resetCropRect(true);setCropDefaults();drawImage(st.img);log('Imagen cargada: '+f.name)}catch(err){log('Error: '+err.message);status('No se pudo cargar la imagen.','stop')}}
async function startCam(){if(!navigator.mediaDevices?.getUserMedia){alert('Este navegador no soporta cámara.');return}try{st.stream=await navigator.mediaDevices.getUserMedia({video:{facingMode:'environment'},audio:false});e.video.srcObject=st.stream;status('Cámara encendida.','ok');log('Cámara encendida.')}catch(err){log('Error cámara: '+err.message);status('No se pudo encender cámara.','stop')}}function stopCam(){if(st.stream){st.stream.getTracks().forEach(t=>t.stop());st.stream=null;e.video.srcObject=null;log('Cámara detenida.')}}async function capture(){if(!e.video.srcObject){alert('Primero enciende la cámara.');return}const c=document.createElement('canvas');c.width=e.video.videoWidth||1280;c.height=e.video.videoHeight||720;c.getContext('2d').drawImage(e.video,0,0,c.width,c.height);const im=new Image();await new Promise((res,rej)=>{im.onload=res;im.onerror=rej;im.src=c.toDataURL('image/png')});st.img=im;resetCropRect(true);setCropDefaults();drawImage(im);log('Foto capturada.')}
function percentile(a,p){if(!a.length)return 0;return a[Math.floor((a.length-1)*p)]}function processImage(next=true){
if(!st.sourceReady){alert('Primero carga una imagen.');return false}
const s=st.size,cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100,img=e.sctx.getImageData(0,0,s,s).data,contrast=Number(e.contrast.value),bright=Number(e.brightness.value),gamma=Number(e.gamma.value),factor=(259*(contrast+255))/(255*(259-contrast));
const darkBase=new Float32Array(s*s),grayBase=new Float32Array(s*s),mask=new Uint8Array(s*s),vals=[];
for(let y=0;y<s;y++)for(let x=0;x<s;x++){
 const i=y*s+x,k=i*4,dx=x-cx,dy=y-cy,d=Math.hypot(dx,dy);
 if(d>r){darkBase[i]=0;grayBase[i]=255;continue}
 mask[i]=1;
 let gray=.299*img[k]+.587*img[k+1]+.114*img[k+2];
 gray=clamp(factor*(gray-128)+128+bright,0,255);gray=clamp(255*Math.pow(gray/255,1/gamma),0,255);grayBase[i]=gray;
 let dark=e.negative.checked?gray:255-gray;if(d>r*.94)dark*=clamp((r-d)/(r*.06),0,1);darkBase[i]=dark;vals.push(dark)
}
if(e.normalize.checked&&vals.length){vals.sort((a,b)=>a-b);const lo=percentile(vals,.08),hi=Math.max(lo+1,percentile(vals,.94));for(let i=0;i<darkBase.length;i++)darkBase[i]=clamp((darkBase[i]-lo)*255/(hi-lo),0,255)}
const clean=Number(e.cleanup.value),den=Math.max(1,255-clean);for(let i=0;i<darkBase.length;i++)darkBase[i]=darkBase[i]<clean?0:clamp((darkBase[i]-clean)*255/den,0,255);
const edge=new Float32Array(s*s);let maxEdge=1;
for(let y=1;y<s-1;y++)for(let x=1;x<s-1;x++){
 const i=y*s+x;if(!mask[i])continue;
 const a=grayBase[(y-1)*s+x-1],b=grayBase[(y-1)*s+x],c=grayBase[(y-1)*s+x+1],d=grayBase[y*s+x-1],f=grayBase[y*s+x+1],g=grayBase[(y+1)*s+x-1],h=grayBase[(y+1)*s+x],j=grayBase[(y+1)*s+x+1];
 const gx=-a+c-2*d+2*f-g+j,gy=-a-2*b-c+g+2*h+j,mag=Math.hypot(gx,gy);edge[i]=mag;if(mag>maxEdge)maxEdge=mag
}
for(let i=0;i<edge.length;i++)edge[i]=clamp(edge[i]*255/maxEdge,0,255);
const mode=e.detailMode?e.detailMode.value:'portrait',target=new Float32Array(s*s);
for(let y=0;y<s;y++)for(let x=0;x<s;x++){
 const i=y*s+x;if(!mask[i]){target[i]=0;continue}
 const nx=(x-cx)/r,ny=(y-cy)/r,center=clamp(1.16-.62*Math.hypot(nx*.86,ny*1.05),.36,1),vertical=clamp(1.03-.34*Math.abs(ny),.62,1);
 let v;
 if(mode==='edges')v=edge[i]*1.18+darkBase[i]*.28;
 else if(mode==='shadows')v=darkBase[i]*1.05;
 else if(mode==='balanced')v=darkBase[i]*.70+edge[i]*.46;
 else v=(darkBase[i]*.42+edge[i]*.96)*center*vertical;
 if(mode==='portrait'&&edge[i]<22&&darkBase[i]>150&&center<.74)v*=.28;
 const gain=mode==='edges'?1.10:(mode==='balanced'?1.06:(mode==='shadows'?1.07:1.05));
 v=clamp(v*gain,0,255);
 target[i]=v
}
st.target=target;st.residual=Float32Array.from(target);st.drawn=new Float32Array(target.length);st.processed=true;st.cache.clear();buildPins();drawProcessed();st.seq=[];st.segs=[];st.points=[];st.pointSeq=[];st.animIndex=0;drawArt(0);buildCommands();e.processedTag.textContent=`${mode} · limpieza ${clean}`;status('Mapa procesado listo.','ok');log(`Procesamiento v6.2 listo: modo ${mode}; mezcla afinada de sombras y bordes, con refuerzo tonal suave.`);if(next)setStep(2);return true}
function drawProcessed(){const s=st.size;clearCanvas(e.pctx);if(!st.target)return;const out=e.pctx.createImageData(s,s);for(let i=0;i<st.target.length;i++){const v=255-clamp(Math.round(st.target[i]),0,255),k=i*4;out.data[k]=v;out.data[k+1]=v;out.data[k+2]=v;out.data[k+3]=255}e.pctx.putImageData(out,0,0);const cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100;e.pctx.save();e.pctx.strokeStyle='rgba(22,130,168,.45)';e.pctx.lineWidth=2;e.pctx.beginPath();e.pctx.arc(cx,cy,r,0,Math.PI*2);e.pctx.stroke();e.pctx.restore();if(e.showPins.checked)drawPins(e.pctx)}
function buildPins(){const n=Number(e.pinCount.value),s=st.size,cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100;st.pins=[];for(let i=0;i<n;i++){const a=-Math.PI/2+i*Math.PI*2/n;st.pins.push({index:i,x:cx+r*Math.cos(a),y:cy+r*Math.sin(a),angle:a})}if(currentMode()!=='points')e.mPins.textContent=String(n)}function drawPins(ctx){if(!st.pins.length)return;const rr=Math.max(1.7,st.size/260);ctx.save();for(const p of st.pins){ctx.beginPath();ctx.arc(p.x,p.y,rr,0,Math.PI*2);ctx.fillStyle='rgba(255,255,255,.94)';ctx.fill();ctx.strokeStyle='rgba(8,117,155,.72)';ctx.lineWidth=1;ctx.stroke()}ctx.restore()}
function ring(a,b,n){const d=Math.abs(a-b);return Math.min(d,n-d)}function key(a,b){return a<b?`${a}-${b}`:`${b}-${a}`}function linePixels(a,b){const k=key(a,b);if(st.cache.has(k))return st.cache.get(k);const A=st.pins[a],B=st.pins[b],dx=B.x-A.x,dy=B.y-A.y,steps=Math.max(1,Math.ceil(Math.hypot(dx,dy))),arr=[];let last=-1;for(let i=0;i<=steps;i++){const t=i/steps,x=clamp(Math.round(A.x+dx*t),0,st.size-1),y=clamp(Math.round(A.y+dy*t),0,st.size-1),idx=y*st.size+x;if(idx!==last){arr.push(idx);last=idx}}const typed=Int32Array.from(arr);st.cache.set(k,typed);return typed}function scoreLine(px,impact){let improvement=0;for(let i=0;i<px.length;i++){const idx=px[i],before=st.drawn[idx],after=Math.min(255,before+impact),e0=st.target[idx]-before,e1=st.target[idx]-after;improvement+=(e0*e0)-(e1*e1)}return improvement/Math.pow(px.length,.84)}function applyLine(px,impact,rad){const s=st.size;if(rad<=0){for(let i=0;i<px.length;i++){const idx=px[i];st.drawn[idx]=Math.min(255,st.drawn[idx]+impact);st.residual[idx]=Math.max(0,st.target[idx]-st.drawn[idx])}return}for(let i=0;i<px.length;i++){const idx=px[i],x=idx%s,y=Math.floor(idx/s);for(let oy=-rad;oy<=rad;oy++)for(let ox=-rad;ox<=rad;ox++){if(ox*ox+oy*oy>rad*rad)continue;const px2=x+ox,py=y+oy;if(px2<0||py<0||px2>=s||py>=s)continue;const j=py*s+px2,f=1-Math.min(.85,Math.hypot(ox,oy)/(rad+1));st.drawn[j]=Math.min(255,st.drawn[j]+impact*f);st.residual[j]=Math.max(0,st.target[j]-st.drawn[j])}}}
function errMean(){if(!st.residual)return null;let sum=0,c=0;for(let i=0;i<st.residual.length;i++)if(st.target[i]>0){sum+=st.residual[i];c++}return c?sum/c:0}function startPin(){let best=0,bs=-1,cx=st.size/2,cy=st.size/2;for(const p of st.pins){const x=Math.round(p.x*.72+cx*.28),y=Math.round(p.y*.72+cy*.28),sc=st.residual[y*st.size+x]||0;if(sc>bs){bs=sc;best=p.index}}return best}
function plotSettings(){const width=clamp(Number(e.plotWidth.value)||200,20,800),height=clamp(Number(e.plotHeight.value)||200,20,800),margin=clamp(Number(e.plotMargin.value)||0,0,Math.min(width,height)/2-1);const maxSide=Math.max(1,Math.min(width,height)-margin*2);const scale=maxSide/st.size;const offsetX=(width-st.size*scale)/2;const offsetY=(height-st.size*scale)/2;return{width,height,margin,scale,offsetX,offsetY,invertY:e.invertY.checked}}
function mapPointToPlot(p,settings){const s=settings||plotSettings();let x=p.x*s.scale+s.offsetX,y=p.y*s.scale+s.offsetY;if(s.invertY)y=s.height-y;return{x:clamp(x,0,s.width),y:clamp(y,0,s.height)}}
function orderPointsSerpentine(points){const rows=new Map();for(const p of points){const row=p.gridY;const list=rows.get(row)||[];list.push(p);rows.set(row,list)}const ordered=[];const keys=[...rows.keys()].sort((a,b)=>a-b);for(const row of keys){const list=rows.get(row);list.sort((a,b)=>a.x-b.x);if(row%2===1)list.reverse();ordered.push(...list)}return ordered}
function orderPointsNearest(points){const remaining=points.slice();const ordered=[];let current={x:st.size/2,y:st.size/2};while(remaining.length){let best=0,bd=Infinity;for(let i=0;i<remaining.length;i++){const p=remaining[i];const d=(p.x-current.x)**2+(p.y-current.y)**2;if(d<bd){bd=d;best=i}}const [pick]=remaining.splice(best,1);ordered.push(pick);current=pick}return ordered}
function buildPointField(){const step=clamp(Number(e.pointStep.value)||8,3,60),density=clamp(Number(e.pointDensity.value)||1,.2,2.4),s=st.size,cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100,w=Math.max(1,Math.floor(s/step)),h=Math.max(1,Math.floor(s/step)),vals=new Float32Array(w*h);for(let y=0;y<h;y++)for(let x=0;x<w;x++){const px=clamp(Math.round((x+.5)*step),0,s-1),py=clamp(Math.round((y+.5)*step),0,s-1);if(Math.hypot(px-cx,py-cy)>r){vals[y*w+x]=0;continue}const idx=py*s+px;vals[y*w+x]=clamp((st.target[idx]||0)/255*density,0,1)}return{step,w,h,vals}}
function generatePoints(){if(st.generating)return;if(!st.processed&&!processImage(false))return;st.generating=true;st.stopGeneration=false;status('Generando puntos con dithering…','warn');log('Generación de puntos iniciada (dithering + orden de trazado).');const field=buildPointField();const err=new Float32Array(field.w*field.h);const points=[];const maxPoints=Number(e.maxPoints.value)||0;for(let y=0;y<field.h;y++){const dir=y%2===0?1:-1;for(let xi=0;xi<field.w;xi++){const x=dir===1?xi:field.w-1-xi;const idx=y*field.w+x;let v=field.vals[idx]+err[idx];const out=v>=.5?1:0;const diff=v-out;if(out){points.push({x:(x+.5)*field.step,y:(y+.5)*field.step,intensity:field.vals[idx],gridY:y})}const add=(ox,oy,wt)=>{const nx=x+ox,ny=y+oy;if(nx<0||ny<0||nx>=field.w||ny>=field.h)return;err[ny*field.w+nx]+=diff*wt};if(dir===1){add(1,0,7/16);add(-1,1,3/16);add(0,1,5/16);add(1,1,1/16)}else{add(-1,0,7/16);add(1,1,3/16);add(0,1,5/16);add(-1,1,1/16)}}}if(maxPoints>0&&points.length>maxPoints){points.sort((a,b)=>b.intensity-a.intensity);points.length=maxPoints}const orderMode=e.pointOrder.value;const ordered=orderMode==='nearest'&&points.length<=2500?orderPointsNearest(points):orderPointsSerpentine(points);if(orderMode==='nearest'&&points.length>2500)log('Modo vecino cercano desactivado: demasiados puntos para ordenar rápido.');st.points=points;st.pointSeq=ordered;st.animIndex=0;st.segs=[];st.seq=[];prog(e.genBar,points.length,Math.max(points.length,1));e.genLabel.textContent=`Puntos listos: ${ordered.length}. Paso ${field.step}px · densidad ${Number(e.pointDensity.value).toFixed(2)}×.`;status(`Puntos listos (${ordered.length}).`,'ok');log(`Generación de puntos lista: ${ordered.length} puntos.`);drawArt(0);metrics(0);buildCommands();st.generating=false;setStep(3)}
async function generate(){if(currentMode()==='points'){generatePoints();return}if(st.generating)return;if(!st.processed&&!processImage(false))return;buildPins();drawProcessed();st.residual=Float32Array.from(st.target);st.drawn=new Float32Array(st.target.length);st.seq=[];st.segs=[];st.animIndex=0;st.cache.clear();st.stopGeneration=false;st.generating=true;const n=st.pins.length,max=Number(e.lineCount.value),gap=Number(e.minGap.value),impact=Number(e.impact.value),rad=Number(e.threadRadius.value),recentLim=Number(e.recent.value),minSc=Number(e.minScore.value),edgePen=Number(e.edgePenalty.value);let cur=startPin();st.startPin=cur;st.seq.push(cur);const recent=[cur],used=new Set();prog(e.genBar,0);status('Generando con algoritmo greedy + MSE…','warn');log(`Generación v6.2 greedy/MSE: ${n} pines, máximo ${max} líneas, pin inicial ${cur}.`);for(let line=0;line<max;line++){if(st.stopGeneration){log('Generación detenida.');break}let bp=-1,bs=-Infinity,bpix=null;for(let cand=0;cand<n;cand++){if(cand===cur)continue;if(ring(cur,cand,n)<gap)continue;const pix=linePixels(cur,cand);let sc=scoreLine(pix,impact);if(recent.includes(cand))sc-=60;if(used.has(key(cur,cand)))sc-=edgePen;if(sc>bs){bs=sc;bp=cand;bpix=pix}}if(bp<0||bs<=0){log(`Fin en línea ${line+1}: ya no hay cuerdas con mejora positiva (${bs.toFixed(2)}).`);break}if(bs<minSc&&line>max*.92){log(`Corte final por mejora baja en línea ${line+1} (${bs.toFixed(2)}).`);break}st.segs.push({from:cur,to:bp,score:Number(bs.toFixed(3))});st.seq.push(bp);used.add(key(cur,bp));applyLine(bpix,impact,rad);cur=bp;recent.push(cur);if(recent.length>recentLim)recent.shift();if(line%12===0||line===max-1){drawArt(st.segs.length);metrics(st.segs.length);prog(e.genBar,st.segs.length,max);e.genLabel.textContent=`Generando… ${st.segs.length}/${max}. Error medio: ${errMean().toFixed(1)}`;await sleep(0)}}st.generating=false;drawArt(st.segs.length);metrics(st.segs.length);prog(e.genBar,st.segs.length,max);buildCommands();e.genLabel.textContent=`Secuencia lista: ${st.segs.length} líneas, ${n} pines. Error residual medio: ${errMean().toFixed(1)}.`;status(`String art listo (${st.segs.length} líneas).`,'ok');log(`Generación completada: ${st.segs.length} líneas.`);setStep(3)}
function metrics(l){const mode=currentMode();if(mode==='points'){const total=st.pointSeq.length;const safeL=typeof l==='number'?l:total;e.mPins.textContent=String(total);e.mLines.textContent=String(safeL);const idx=Math.min(Math.max(safeL-1,0),Math.max(total-1,0));e.mPin.textContent=total?String(idx+1):'—';e.mErr.textContent='—';e.stringTag.textContent=`${total} puntos`;return}const lines=typeof l==='number'?l:st.segs.length;e.mLines.textContent=String(lines);const pin=st.seq[Math.min(lines,st.seq.length-1)];e.mPin.textContent=pin===undefined?'—':String(pin);const er=errMean();e.mErr.textContent=er==null?'—':er.toFixed(1);e.stringTag.textContent=`${lines} líneas`}function drawArt(limit){const ctx=e.actx,s=st.size,cx=s/2,cy=s/2,r=s*Number(e.circleRadius.value)/100;const mode=currentMode();clearCanvas(ctx);ctx.save();const g=ctx.createRadialGradient(cx-r*.24,cy-r*.28,r*.1,cx,cy,r*1.05);g.addColorStop(0,'#fff');g.addColorStop(.55,'rgba(245,253,255,.94)');g.addColorStop(1,'rgba(218,247,239,.9)');ctx.fillStyle=g;ctx.strokeStyle='rgba(9,95,130,.28)';ctx.lineWidth=2;ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);ctx.fill();ctx.stroke();ctx.restore();if(mode==='points'){const total=st.pointSeq.length;const lim=Math.min(typeof limit==='number'?limit:total,total);const pr=Math.max(1.2,st.size/480);ctx.save();ctx.globalAlpha=Number(e.opacity.value);ctx.fillStyle='rgba(5,5,5,.9)';for(let i=0;i<lim;i++){const p=st.pointSeq[i];if(!p)continue;ctx.beginPath();ctx.arc(p.x,p.y,pr,0,Math.PI*2);ctx.fill()}ctx.restore();if(lim>0&&lim<=total){const p=st.pointSeq[lim-1];if(p){ctx.save();ctx.globalAlpha=.35;ctx.strokeStyle='#11aee8';ctx.lineWidth=3;ctx.beginPath();ctx.arc(p.x,p.y,pr*2.1,0,Math.PI*2);ctx.stroke();ctx.restore()}}metrics(lim);return}ctx.save();ctx.globalAlpha=Number(e.opacity.value);ctx.strokeStyle='#050505';ctx.lineWidth=1.05;ctx.lineCap='round';const lim=Math.min(typeof limit==='number'?limit:st.segs.length,st.segs.length);for(let i=0;i<lim;i++){const seg=st.segs[i],a=st.pins[seg.from],b=st.pins[seg.to];ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke()}ctx.restore();if(lim>0&&lim<=st.segs.length){const seg=st.segs[lim-1],a=st.pins[seg.from],b=st.pins[seg.to];ctx.save();ctx.globalAlpha=.28;ctx.strokeStyle='#11aee8';ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();ctx.restore()}drawPins(ctx);metrics(lim)}
function animTotal(){return currentMode()==='points'?st.pointSeq.length:st.segs.length}function anim(ts){if(!st.anim)return;const inter=1000/Math.max(1,Number(e.speed.value));if(!st.lastAnim)st.lastAnim=ts;if(ts-st.lastAnim>=inter){st.lastAnim=ts;const total=animTotal();st.animIndex=Math.min(total,st.animIndex+1);drawArt(st.animIndex);if(st.animIndex>=total){stopAnim();return}}st.raf=requestAnimationFrame(anim)}function play(reset=false){const total=animTotal();if(!total){alert(currentMode()==='points'?'Primero genera los puntos.':'Primero genera la secuencia.');return}if(reset)st.animIndex=0;stopAnim();st.anim=true;st.lastAnim=0;st.raf=requestAnimationFrame(anim)}function stopAnim(){st.anim=false;if(st.raf)cancelAnimationFrame(st.raf);st.raf=null}function stepAnim(){const total=animTotal();if(!total)return;stopAnim();st.animIndex=Math.min(total,st.animIndex+1);drawArt(st.animIndex)}function resetAnim(){stopAnim();st.animIndex=0;drawArt(0)}
function buildCommands(){const mode=currentMode();if(mode==='points'){if(!st.pointSeq.length){e.cmd.value='';return}const settings=plotSettings();const out=[`# XY Stringbot plotter job`,`# Generated ${new Date().toISOString()}`,`# Points ${st.pointSeq.length}`,`# Plot ${settings.width}x${settings.height}mm`,`PLOT_BEGIN ${st.pointSeq.length} ${settings.width} ${settings.height}`];for(const p of st.pointSeq){const pt=mapPointToPlot(p,settings);out.push(`DOT ${pt.x.toFixed(2)} ${pt.y.toFixed(2)}`)}out.push('PLOT_END');e.cmd.value=out.join('\n');return}if(!st.pins.length||!st.seq.length){e.cmd.value='';return}const out=[`# XY Stringbot job`,`# Generated ${new Date().toISOString()}`,`# Pins ${st.pins.length}`,`# Lines ${st.segs.length}`,`JOB_BEGIN ${st.pins.length} ${st.segs.length} ${st.startPin}`];for(let i=1;i<st.seq.length;i++){const pin=st.seq[i],p=st.pins[pin];out.push(e.sendXY.checked?`PINXY ${pin} ${p.x.toFixed(2)} ${p.y.toFixed(2)}`:`PIN ${pin}`)}out.push('JOB_END');e.cmd.value=out.join('\n')}
function exportPayload(){const mode=currentMode();if(mode==='points'){const settings=plotSettings();const pointsPlot=st.pointSeq.map(p=>mapPointToPlot(p,settings));return{generatedAt:new Date().toISOString(),mode:'points',canvasSize:st.size,plot:{width:settings.width,height:settings.height,margin:settings.margin,invertY:settings.invertY},pointsPx:st.pointSeq.map(p=>({x:p.x,y:p.y})),points:pointsPlot}}return{generatedAt:new Date().toISOString(),mode:'string',pins:st.pins,startPin:st.startPin,sequence:st.seq,segments:st.segs}}
function download(name,thing,type='text/plain;charset=utf-8'){const blob=thing instanceof Blob?thing:new Blob([thing],{type}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000)}function canvasDown(c,name){c.toBlob(b=>b&&download(name,b,'image/png'))}
async function connectSerial(){if(!st.serialSupported){alert('Tu navegador no soporta Web Serial. Usa Chrome o Edge.');return}try{st.port=await navigator.serial.requestPort();await st.port.open({baudRate:Number(e.baud.value)});st.keepRead=true;st.queue=[];st.buffer='';readLoop();e.serialStatus.textContent='Puerto conectado.';e.mSerial.textContent='On';status('COM conectado.','ok');log(`COM abierto a ${e.baud.value} baudios.`)}catch(err){log('Error COM: '+err.message);status('No se pudo abrir COM.','stop')}}async function disconnectSerial(){st.keepRead=false;if(st.reader){try{await st.reader.cancel()}catch(_){}try{st.reader.releaseLock()}catch(_){}st.reader=null}if(st.port){try{await st.port.close()}catch(_){}st.port=null}e.mSerial.textContent='Off';e.serialStatus.textContent='Sin conexión serial.';log('COM desconectado.')}async function readLoop(){const dec=new TextDecoder();while(st.port&&st.port.readable&&st.keepRead){st.reader=st.port.readable.getReader();try{while(st.keepRead){const {value,done}=await st.reader.read();if(done)break;if(value){st.buffer+=dec.decode(value,{stream:true});const lines=st.buffer.split(/\r\n|\n|\r/);st.buffer=lines.pop()||'';for(const l of lines){const t=l.trim();if(t){st.queue.push(t);log('RX < '+t)}}}}}catch(err){if(st.keepRead)log('Error RX: '+err.message)}finally{try{st.reader.releaseLock()}catch(_){}st.reader=null}}}async function writeLine(line){const w=st.port.writable.getWriter();try{await w.write(st.enc.encode(line+ending()));log('TX > '+line)}finally{w.releaseLock()}}async function waitAck(ms){const start=performance.now();while(performance.now()-start<ms){if(st.queue.length){const l=st.queue.shift();if(/\b(OK|ACK|READY|NEXT|DONE)\b/i.test(l))return l}await sleep(20)}throw new Error('Timeout esperando ACK/OK.')}async function sendSeq(){if(!st.port){alert('Primero conecta COM.');return}const mode=currentMode();if(mode==='points'&&!st.pointSeq.length){alert('Primero genera puntos.');return}if(mode!=='points'&&!st.seq.length){alert('Primero genera una secuencia.');return}st.sending=true;st.stopSending=false;const wait=e.handshake.checked,timeout=Number(e.ackTimeout.value);try{prog(e.sendBar,0);status('Enviando por COM…','warn');if(mode==='points'){const settings=plotSettings();await writeLine(`PLOT_BEGIN ${st.pointSeq.length} ${settings.width} ${settings.height}`);if(wait)await waitAck(timeout);for(let i=0;i<st.pointSeq.length;i++){if(st.stopSending)throw new Error('Envío cancelado.');const pt=mapPointToPlot(st.pointSeq[i],settings);await writeLine(`DOT ${pt.x.toFixed(2)} ${pt.y.toFixed(2)}`);if(wait)await waitAck(timeout);prog(e.sendBar,i+1,st.pointSeq.length);e.serialStatus.textContent=`Enviando ${i+1}/${st.pointSeq.length}…`}await writeLine('PLOT_END');if(wait)await waitAck(timeout);e.serialStatus.textContent='Puntos enviados correctamente.';status('Puntos enviados.','ok');log('Envío de puntos finalizado.')}else{await writeLine(`JOB_BEGIN ${st.pins.length} ${st.segs.length} ${st.startPin}`);if(wait)await waitAck(timeout);for(let i=1;i<st.seq.length;i++){if(st.stopSending)throw new Error('Envío cancelado.');const pin=st.seq[i],p=st.pins[pin];await writeLine(e.sendXY.checked?`PINXY ${pin} ${p.x.toFixed(2)} ${p.y.toFixed(2)}`:`PIN ${pin}`);if(wait)await waitAck(timeout);prog(e.sendBar,i,st.seq.length-1);e.serialStatus.textContent=`Enviando ${i}/${st.seq.length-1}…`}await writeLine('JOB_END');if(wait)await waitAck(timeout);e.serialStatus.textContent='Secuencia enviada correctamente.';status('Secuencia enviada.','ok');log('Envío finalizado.')}}catch(err){e.serialStatus.textContent='Error: '+err.message;status('Error durante envío.','stop');log('Error envío: '+err.message)}finally{st.sending=false}}
function clearAll(){st.img=null;st.crop.rect=null;setCropDefaults();st.sourceReady=false;st.processed=false;st.target=null;st.residual=null;st.pins=[];st.seq=[];st.segs=[];st.points=[];st.pointSeq=[];st.animIndex=0;st.cache.clear();e.originalTag.textContent='Sin imagen';e.processedTag.textContent='Pendiente';e.stringTag.textContent=currentMode()==='points'?'0 puntos':'0 líneas';e.cmd.value='';e.mPins.textContent='0';e.mLines.textContent='0';e.mPin.textContent='—';e.mErr.textContent='—';prog(e.genBar,0);prog(e.sendBar,0);initCanvases();status('Todo limpio.','warn');log('Proyecto limpiado.');setStep(0)}
function bind(){tiles.forEach(t=>t.addEventListener('click',()=>setStep(Number(t.dataset.step))));e.prev.addEventListener('click',()=>setStep(st.step-1));e.next.addEventListener('click',()=>setStep(st.step+1));initDrag();bindCropDrag();e.image.addEventListener('change',onFile);e.startCam.addEventListener('click',startCam);e.cap.addEventListener('click',capture);e.stopCam.addEventListener('click',stopCam);e.clear.addEventListener('click',clearAll);e.openCropEditor.addEventListener('click',openCropEditor);e.inputProfile.addEventListener('change',()=>applyProfile(false));e.applyProfileBtn.addEventListener('click',()=>applyProfile(true));e.cropZoom.addEventListener('input',()=>handleCropChange(false));e.cropX.addEventListener('input',()=>handleCropChange(false));e.cropY.addEventListener('input',()=>handleCropChange(false));e.cropZoom.addEventListener('change',()=>handleCropChange(true));e.cropX.addEventListener('change',()=>handleCropChange(true));e.cropY.addEventListener('change',()=>handleCropChange(true));e.cropReset.addEventListener('click',()=>{e.cropZoom.value='1';e.cropX.value='0';e.cropY.value='0';handleCropChange(true)});e.cropEditorCancel.addEventListener('click',closeCropEditor);e.cropEditorApply.addEventListener('click',applyCropEditor);e.cropEditorReset.addEventListener('click',resetCropEditorRect);e.cropEditorCenter.addEventListener('click',centerCropEditorRect);e.cropEditorZoom.addEventListener('input',()=>{e.cropEditorZoomVal.textContent=Number(e.cropEditorZoom.value).toFixed(2)+'×'});e.cropCanvas.addEventListener('pointerdown',startCropDrag);e.cropCanvas.addEventListener('pointermove',moveCropDrag);e.cropCanvas.addEventListener('pointerup',endCropDrag);e.cropCanvas.addEventListener('pointercancel',endCropDrag);[e.contrast,e.brightness,e.gamma,e.cleanup,e.circleRadius,e.opacity,e.speed,e.pointDensity].forEach(x=>x.addEventListener('input',syncLabels));e.outputMode.addEventListener('change',updateModeUI);e.pointStep.addEventListener('change',buildCommands);e.maxPoints.addEventListener('change',buildCommands);e.pointOrder.addEventListener('change',buildCommands);e.plotWidth.addEventListener('change',buildCommands);e.plotHeight.addEventListener('change',buildCommands);e.plotMargin.addEventListener('change',buildCommands);e.invertY.addEventListener('change',buildCommands);e.canvasSize.addEventListener('change',resize);e.process.addEventListener('click',()=>processImage(true));e.detailMode.addEventListener('change',()=>{if(st.sourceReady)processImage(false)});e.dlProc.addEventListener('click',()=>canvasDown(e.proc,'xy_stringbot_mapa_procesado.png'));e.showPins.addEventListener('change',drawProcessed);e.pinCount.addEventListener('change',()=>{if(st.processed){buildPins();drawProcessed();drawArt(st.animIndex)}});e.generate.addEventListener('click',generate);e.stopGen.addEventListener('click',()=>{st.stopGeneration=true});e.play.addEventListener('click',()=>play(false));e.pause.addEventListener('click',stopAnim);e.step.addEventListener('click',stepAnim);e.reset.addEventListener('click',resetAnim);e.opacity.addEventListener('input',()=>drawArt(st.animIndex||animTotal()));e.dlTxt.addEventListener('click',()=>download('xy_stringbot_secuencia.txt',e.cmd.value));e.dlJson.addEventListener('click',()=>download('xy_stringbot_secuencia.json',JSON.stringify(exportPayload(),null,2),'application/json;charset=utf-8'));e.dlArt.addEventListener('click',()=>canvasDown(e.art,'xy_stringbot_string_art.png'));e.sendXY.addEventListener('change',buildCommands);e.connect.addEventListener('click',connectSerial);e.disconnect.addEventListener('click',disconnectSerial);e.send.addEventListener('click',sendSeq);e.stopSend.addEventListener('click',()=>{st.stopSending=true});window.addEventListener('beforeunload',()=>{stopAnim();stopCam()})}
function init(){syncLabels();initCanvases();bind();updateModeUI();setStep(0);const cam=!!navigator.mediaDevices?.getUserMedia;e.support.textContent=`Cámara: ${cam?'sí':'no'} · Web Serial: ${st.serialSupported?'sí':'no'} · Recomendado: Chrome/Edge`;e.mSerial.textContent=st.serialSupported?'Listo':'No';status('Listo. Empieza por Entrada.','ok');log('Xy Stringbot Studio v6.2 web tuned listo. Algoritmo MSE + modo puntos con dithering y orden optimizado para plotter.')}init();
})();
